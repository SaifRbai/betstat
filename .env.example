# ---------------------------------------------------------------------------
# foot_edge - modele de configuration
# Copie ce fichier en ".env" (dans le meme dossier) et remplis les valeurs.
# Le fichier .env ne doit JAMAIS etre commite ni partage.
# ---------------------------------------------------------------------------

# Cotes multi-bookmakers (1N2, over/under). 500 requetes/mois offertes.
# Inscription : https://the-odds-api.com/#get-access
ODDS_API_KEY=votre_cle_ici

# Calendrier et resultats officiels. Cle gratuite.
# Inscription : https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=votre_cle_ici

# Blessures et compositions probables. 100 requetes/jour offertes.
# Inscription : https://www.api-football.com/pricing
API_FOOTBALL_KEY=votre_cle_ici

# Optionnel : deplacer le dossier de donnees (defaut : ~/.foot_edge)
# FOOT_EDGE_HOME=/chemin/vers/donnees
